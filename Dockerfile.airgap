# CCOP v1.0 — 폐쇄망 슬림 이미지 (RAG 의존성/torch 미포함)
#   build_airgap_bundle.sh 가 이 파일이 있으면 자동 사용.
#   requirements.airgap.txt + .dockerignore 와 함께 이미지 7.8GB → ~1GB.
FROM python:3.10-slim AS base

WORKDIR /app

# 시스템 의존성 (psycopg2 빌드용)
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 슬림 requirements (RAG/torch 제외)
COPY requirements.airgap.txt .
RUN pip install --no-cache-dir -r requirements.airgap.txt

# 애플리케이션 코드 (.dockerignore 로 data/train/results 등 대용량 제외)
COPY . .

# 비루트 사용자
RUN useradd -m -u 1000 ccop && chown -R ccop:ccop /app
USER ccop

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5001/')"

CMD ["gunicorn", "--config", "deploy/gunicorn_config.py", "run:app"]
