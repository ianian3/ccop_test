# ============================================================
# CCOP v1.0 — 폐쇄망 1차(인프라) 환경설정 템플릿
#   사용(폐쇄망 VM, /opt/ccop 에서):  cp deploy/.env.airgap.phase1.template .env
#   2차(GPU+T2C) 전환: 하단 SLLM 두 줄 + VLLM_TAG 주석 해제 후
#     docker compose -f docker-compose.airgap.yml --profile gpu up -d
#     docker compose -f docker-compose.airgap.yml up -d app
# ============================================================

# ── DB ──────────────────────────────────────────────────────
#   시나리오 A (현장 확인됨 2026-07-14): 네이티브 AgensGraph 16.9 선설치
#     → docker-compose.airgap.nativedb.yml 사용 + 아래 기본값 적용
#     (deploy/AIRGAP_SITE_DB_LOG_20260714.md 참조)
DB_NAME=tccopdb                 # DBA 협의 복원 DB명 (기본 DB 'agens' 재사용 시 변경)
DB_USER=ccop                    # 앱 전용 계정 신설 권장 — 슈퍼유저(hlucyber) 사용 금지
DB_PASSWORD=<강력한_비밀번호_입력>
DB_HOST=host.docker.internal    # nativedb compose 의 host-gateway 경유 네이티브 DB
DB_PORT=5333                    # 현장 작업일지 기준 포트
#   시나리오 B (폴백 — DB 컨테이너 포함, docker-compose.airgap.yml 사용 시):
# DB_HOST=agensgraph
# DB_PORT=5432

# ── 그래프 기본값 ──────────────────────────────────────────
DEFAULT_GRAPH_PATH=tccop_graph_v6   # ⚠️ osint_ontology(6.89M) 기본값 금지

# ── LLM ── 1차: 둘 다 미설정 (자연어→Cypher 만 유예, 나머지 전부 정상) ──
#   OPENAI_API_KEY 는 폐쇄망에서 설정 금지 (placeholder 여도 자연어 질의 401)
#   ── 2차(GPU+T2C) 전환 시 아래 세 줄 주석 해제 ──
# SLLM_ENDPOINT=http://sllm:8000/v1
# SLLM_MODEL_NAME=qwen25-t2c-v42
# VLLM_TAG=v0.6.3.post1               # 권장 고정값 — 운영 검증 서빙 레시피와 동일 버전(cu121 빌드, R530+ 드라이버 호환). 변경 시 staging GPU 1회 검증 필수

# ── 보안 ────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=<랜덤_32자이상_문자열>
ADMIN_PASSWORD=<관리자_비밀번호>

# 외부 기관 read-only 그래프 조회 토큰 (X-API-Key). 미설정 시 /api/v1/graph/* 접근 거부(fail-closed).
LLM_API_KEY=<외부조회_토큰_또는_공란>

# ── CORS (nginx server_name / 내부 접속 도메인에 맞춰 수정) ──
CORS_ORIGINS=https://ccop.cslee.internal,http://localhost

# ── 로깅 ────────────────────────────────────────────────────
LOG_LEVEL=INFO
