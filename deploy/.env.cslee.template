# ============================================================
# CCOP v1.0 — CSLEE 환경 설정 템플릿
# 복사 후 .env 로 저장: cp deploy/.env.cslee.template .env
# ============================================================

# ── DB ─────────────────────────────────────────────────────
DB_NAME=ccopdb
DB_USER=ccop
DB_PASSWORD=<강력한_패스워드_입력>
DB_HOST=agensgraph
DB_PORT=5432

# ── LLM 설정 (둘 중 하나만 설정) ──────────────────────────
# [인터넷 환경] OpenAI GPT-4o
OPENAI_API_KEY=sk-...

# [망분리 환경] 온프레미스 sLLM (vLLM 기반)
# SLLM_ENDPOINT=http://sllm:8000/v1
# SLLM_MODEL_NAME=exaone-3.5-7.8b
# 또는 CSLEE 자체 LLM 서버 주소:
# SLLM_ENDPOINT=http://cslee-llm-server.internal:8080/v1
# SLLM_MODEL_NAME=cslee-model-name

# ── 보안 ────────────────────────────────────────────────────
SECRET_KEY=<랜덤_32자_이상_문자열>
ADMIN_PASSWORD=<관리자_패스워드>

# ── CORS — CSLEE 플랫폼 도메인 ──────────────────────────────
CORS_ORIGINS=https://cslee-platform.internal,http://localhost

# ── 그래프 기본값 ────────────────────────────────────────────
DEFAULT_GRAPH_PATH=tccop_graph_v6

# ── 로깅 ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Hugging Face (sLLM 모델 다운로드 시 필요) ───────────────
# HF_TOKEN=hf_...
