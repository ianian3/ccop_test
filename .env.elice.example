# ── 공개용 (엘리스 GPU박스 ~/coop_app) ───────────────────────────────────────
# 성격: 테스트 그래프만 노출 · Basic Auth · 외부 URL 공개
# URL : https://rgfqdkgemgpeygqd.tunnel.elice.io
#       (엘리스 터널 → 앱서버:5001 → SSH 포워딩 → 이 서버:5002)
# 실행: ./start_app.sh  (gunicorn 4워커 0.0.0.0:5002, watchdog.sh 가 자동 복구)

# 운영 DB 직결 — 이 서버 IP(119.59.0.61)가 방화벽 승인 대상.
# ⛔ skai2_vm(175.45.205.106) 경유 경로는 사용 금지.
DB_HOST=49.50.128.28
DB_PORT=5333
DB_NAME=tccopdb
DB_USER=ccop_app_ro
DB_PASSWORD=<ccop_app_ro 비밀번호>

# sLLM 은 같은 서버에서 서빙 — 네트워크 홉 0
SLLM_ENDPOINT=http://localhost:8000/v1
SLLM_MODEL_NAME=qwen25-coder-t2c-v48

OPENAI_API_KEY=<선택>
FLASK_ENV=production
SECRET_KEY=<임의 문자열>
LOG_LEVEL=INFO
LOG_FILE=logs/ccop.log
CORS_ORIGINS=*

# ── 공개용 전용 설정 ────────────────────────────────────────────────────────
# 외부 URL 로 운영 수사데이터(실명·계좌번호)가 나가지 않도록 테스트 그래프만 허용한다.
# 목록 필터 + before_request 차단 이중 적용 — API 에 graph_path 를 직접 넣어도 403.
ALLOWED_GRAPHS=ccop_test_graph
DEFAULT_GRAPH_PATH=ccop_test_graph

# 인증 (엘리스 터널 자체에는 인증이 없다 — 이것이 유일한 방어선)
# ⚠ watchdog health check 는 401 을 정상으로 판정해야 한다(curl -sf 금지).
BASIC_AUTH_USER=ccop
BASIC_AUTH_PASS=<강한 비밀번호로 교체 권장>
