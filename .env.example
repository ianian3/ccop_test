# Environment Configuration Example
# Copy this to .env and fill in your actual values.
# ⚠️ 보안 필수값(SECRET_KEY / ADMIN_PASSWORD)은 반드시 실제 값으로 교체할 것.

# PostgreSQL/AgensGraph Database
DB_NAME=ccopdb
DB_USER=ccop
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# OpenAI API (required for AI query features)
OPENAI_API_KEY=sk-your-openai-key-here

# Flask Configuration
FLASK_ENV=production
# 필수: 미설정 시 프로덕션 기동이 차단됨. 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin Authentication
# 필수: 미설정 시 관리자 로그인이 비활성화됨(fail-closed). 강한 비밀번호로 설정할 것.
ADMIN_PASSWORD=

# 앱 레벨 Basic Auth (선택) — 설정 시 UI/데이터 API 전체를 보호.
# 폐쇄망 등 네트워크 경계로 통제한다면 생략 가능.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# 외부 기관용 read-only 그래프 조회 API 토큰 (X-API-Key).
# 미설정 시 외부 조회 API(/api/v1/graph/*)는 접근을 거부함(fail-closed).
LLM_API_KEY=

# Legal RAG v2 (선택) — 미설정 시: OPENAI_API_KEY 로 임베딩, 그것도 없으면 BM25-only 강등.
# 폐쇄망은 OpenAI 호환 임베딩 서버(vLLM/TEI) 주소를 지정.
# EMBEDDING_ENDPOINT=http://127.0.0.1:8001/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# RAG_RERANK=auto

# Default Graph Path
DEFAULT_GRAPH_PATH=tccop_graph_v6

# RDB 표준화 테이블 스키마
RDB_SCHEMA=test_ccop

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS — 신뢰하는 오리진만 콤마로 구분해 명시할 것. '*' 는 운영에서 사용 금지.
CORS_ORIGINS=http://localhost:5002
