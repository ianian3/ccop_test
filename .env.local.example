# ── 개발용 (로컬 맥) ─────────────────────────────────────────────────────────
# 성격: 전 그래프 접근 · 인증 없음 · 운영 DB 읽기 전용
# 실행: python3 run.py   (Flask dev 서버, localhost:5002, 자동 리로드)

# 운영 DB 직결 — 로컬 회선 IP(211.254.134.154)가 방화벽에 허용돼 있다.
# 회선 IP가 바뀌면 차단되므로 `curl ifconfig.me` 로 확인할 것.
DB_HOST=49.50.128.28
DB_PORT=5333
DB_NAME=tccopdb
# 읽기 전용 계정 — LLM 이 생성한 쿼리가 실행되는 경로이므로 앱은 절대 쓰기 계정을 쓰지 않는다.
# 적재·보정 스크립트는 ccop 계정을 스크립트에서 직접 지정해 쓴다.
DB_USER=ccop_app_ro
DB_PASSWORD=<ccop_app_ro 비밀번호>

# sLLM — 엘리스 GPU박스로 SSH 터널
#   ssh -o ServerAliveInterval=30 -fN -L 8002:localhost:8000 elice_police
SLLM_ENDPOINT=http://localhost:8002/v1
SLLM_MODEL_NAME=qwen25-coder-t2c-v48

OPENAI_API_KEY=<선택: 없으면 sLLM 전용>
FLASK_ENV=development
SECRET_KEY=<임의 문자열>
DEFAULT_GRAPH_PATH=ccop_ep_integrated
LOG_LEVEL=INFO
LOG_FILE=logs/ccop.log
CORS_ORIGINS=*

# 개발용은 그래프 제한·인증을 두지 않는다.
#   ALLOWED_GRAPHS  (미설정 = 전체 허용)
#   BASIC_AUTH_*    (미설정 = 인증 없음)
